---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import ProductSelector from "@/components/submission/product-selector.astro";
import { API_BASE_URL } from "@/utils/api.js";

// Fetch regencies for dropdown
let regencies = [];
try {
  const regencyResponse = await fetch(`${API_BASE_URL}/v2/pickup-regencies`);
  const regencyResult = await regencyResponse.json();
  if (regencyResult.data && Array.isArray(regencyResult.data.order_pickup_regencies)) {
      regencies = regencyResult.data.order_pickup_regencies;
  }
} catch (e) {
  console.error("Failed to fetch regencies", e);
}
---

<Layout title="Submit Sampah">
  <Container>
    <div class="max-w-3xl mx-auto py-12">
      <Sectionhead>
        <Fragment slot="title">Jual Sampah <span class="text-sm align-middle bg-primary/10 text-primary px-2 py-1 rounded-full ml-2">BETA</span></Fragment>
        <Fragment slot="desc">Jual sampah daur ulangmu disini.</Fragment>
      </Sectionhead>

      <form id="submission-form" class="mt-16 space-y-3">
        
        <!-- Personal Information -->
        <div class="space-y-8">
          <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-100 shadow-sm">
            <h3 class="text-xl font-bold text-slate-800 border-b pb-4 border-slate-100 flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary/10 text-primary text-sm font-bold">1</span>
              Informasi Personal
            </h3>
            <div class="mt-6 grid md:grid-cols-2 gap-6">
              <div class="md:col-span-2">
                <label for="name" class="block text-sm font-medium text-slate-700 mb-2">Nama Lengkap <span class="text-red-500">*</span></label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors bg-slate-50 focus:bg-white" placeholder="Nama Anda">
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email <span class="text-red-500">*</span></label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors bg-slate-50 focus:bg-white" placeholder="email@contoh.com">
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Nomor WhatsApp <span class="text-red-500">*</span></label>
                <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors bg-slate-50 focus:bg-white" placeholder="0812...">
              </div>
              <div class="md:col-span-2">
                 <label class="flex items-center gap-2 cursor-pointer group">
                    <div class="relative flex items-center">
                      <input type="checkbox" id="remember-me" class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-slate-300 transition-all checked:border-primary checked:bg-primary hover:shadow-sm" />
                      <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 peer-checked:opacity-100 text-white pointer-events-none">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" stroke="currentColor" stroke-width="1">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                      </span>
                    </div>
                    <span class="text-sm text-slate-600 group-hover:text-slate-800 transition-colors">Simpan detail saya untuk transaksi berikutnya</span>
                 </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Pickup Address -->
        <div class="space-y-8">
          <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-100 shadow-sm">
            <h3 class="text-xl font-bold text-slate-800 border-b pb-4 border-slate-100 flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary/10 text-primary text-sm font-bold">2</span>
              Alamat Penjemputan
            </h3>
            <div class="mt-6 space-y-5">
              <div>
                <label for="address" class="block text-sm font-medium text-slate-700 mb-2">Alamat Lengkap <span class="text-red-500">*</span></label>
                <textarea id="address" name="address" rows="3" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors bg-slate-50 focus:bg-white" placeholder="Nama Jalan, No. Rumah, RT/RW, Kecamatan..."></textarea>
              </div>
              <div>
                <label for="regency" class="block text-sm font-medium text-slate-700 mb-2">Pilih Cabang Kepul Point <span class="text-red-500">*</span></label>
                <div class="relative">
                  <select id="regency" name="regency" required class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors bg-slate-50 focus:bg-white appearance-none cursor-pointer">
                    <option value="">Pilih Kepul Point</option>
                    {regencies.map((regency) => (
                      <option value={regency.id}>{regency.name}</option>
                    ))}
                  </select>
                  <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Product Selection -->
        <div class="space-y-8">
          <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-100 shadow-sm">
            <div class="flex justify-between items-center border-b pb-4 border-slate-100">
              <h3 class="text-xl font-bold text-slate-800 flex items-center gap-3">
                <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary/10 text-primary text-sm font-bold">3</span>
                Detail Sampah
              </h3>
              <button type="button" onclick="window.openProductSelector()" class="text-sm font-medium text-primary hover:text-sky-600 flex items-center gap-1 bg-sky-50 px-4 py-2 rounded-lg hover:bg-sky-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Tambah Item
              </button>
            </div>
            
            <div class="mt-6 space-y-4">
              <div id="cart-empty" class="text-center py-10 bg-slate-50 rounded-xl border border-dashed border-slate-200 cursor-pointer hover:border-primary/50 transition-colors" onclick="window.openProductSelector()">
                <div class="mx-auto w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                </div>
                <p class="text-slate-500 text-sm">Belum ada sampah yang ditambahkan.</p>
                <button type="button" class="mt-2 text-primary text-sm font-bold hover:underline">Pilih dari katalog</button>
              </div>

              <div id="cart-list" class="grid sm:grid-cols-2 gap-3 hidden">
                <!-- Cart items will be injected here -->
              </div>

              <br>
              
              <!-- Image Upload Section -->
              <div class="pt-6 border-t border-slate-100">
                 <div class="flex items-center justify-center w-full">
                     <label for="dropzone-file" class="flex flex-col items-center justify-center w-full h-40 border-2 border-slate-300 border-dashed rounded-xl cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors group">
                         <div class="flex flex-col items-center justify-center pt-5 pb-6">
                             <svg class="w-8 h-8 mb-3 text-slate-400 group-hover:text-primary transition-colors" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                 <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
                             </svg>
                             <p class="text-sm text-slate-500 mb-1"><span class="font-semibold text-primary">Klik untuk upload</span> atau drag & drop</p>
                             <p class="text-xs text-slate-400">Gunakan kamera atau galeri</p>
                         </div>
                         <input id="dropzone-file" name="waste_image" type="file" class="hidden" accept="image/*" capture="environment" />
                     </label>
                 </div>
                 
                 <!-- Preview -->
                 <div id="image-preview-container" class="mt-4 hidden relative w-full max-w-xs">
                     <img id="image-preview" src="#" alt="Preview" class="w-full rounded-lg border border-slate-200 shadow-sm" />
                     <button type="button" id="remove-image" class="absolute top-2 right-2 w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center shadow-md hover:bg-red-600 transition-colors">
                       <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                         <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                       </svg>
                     </button>
                 </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Notes -->
        <div class="space-y-8">
          <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-100 shadow-sm">
            <h3 class="text-xl font-bold text-slate-800 border-b pb-4 border-slate-100 flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary/10 text-primary text-sm font-bold">4</span>
              Catatan Tambahan (optional)
            </h3>
            <div class="mt-6">
              <textarea id="notes" name="notes" rows="2" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-colors bg-slate-50 focus:bg-white" placeholder="Catatan lainnya..."></textarea>
            </div>
          </div>
        </div>

        <!-- Submit -->
        <div class="pt-8 border-t border-slate-100">
          <button type="submit" class="w-full bg-primary hover:bg-sky-600 text-white font-bold py-5 rounded-xl shadow-lg shadow-primary/20 transition-all hover:translate-y-[-2px] hover:shadow-xl flex items-center justify-center gap-2">
            <span>Kirim Permintaan Penjemputan</span>
          </button>
        </div>

      </form>
    </div>
  </Container>

  <!-- Mount Component -->
  <ProductSelector />
</Layout>

<script>
  let cart = [];
  const cartList = document.getElementById('cart-list');
  const cartEmpty = document.getElementById('cart-empty');
  const form = document.getElementById('submission-form');
  
  // LocalStorage Logic
  const STORAGE_KEY = 'kepul_guest_info';
  const nameInput = document.getElementById('name');
  const emailInput = document.getElementById('email');
  const phoneInput = document.getElementById('phone');
  const rememberCheckbox = document.getElementById('remember-me');

  // Load saved data
  const savedData = localStorage.getItem(STORAGE_KEY);
  if (savedData) {
      try {
          // Decode simple base64 hash to prevent casual reading (Not secure, but meets 'hash' request loosely)
          const decoded = JSON.parse(atob(savedData)); 
          if(nameInput) nameInput.value = decoded.name || '';
          if(emailInput) emailInput.value = decoded.email || '';
          if(phoneInput) phoneInput.value = decoded.phone || '';
          if(rememberCheckbox) rememberCheckbox.checked = true;
      } catch (e) {
          console.error("Failed to load saved data", e);
      }
  }

  window.addEventListener('product-selected', (e) => {
    const product = e.detail;
    addToCart(product);
  });

  function addToCart(product) {
    const existing = cart.find(item => item.id === product.id);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }
    renderCart();
  }

  function removeFromCart(id) {
    cart = cart.filter(item => item.id !== id);
    renderCart();
  }

  function updateQuantity(id, change) {
    const item = cart.find(item => item.id === id);
    if (item) {
      item.quantity += change;
      if (item.quantity <= 0) {
        removeFromCart(id);
      } else {
        renderCart();
      }
    }
  }

  // Make functions available globally for inline onclick handlers (simpler than adding listeners to dynamic elements every time)
  window.updateCartQuantity = updateQuantity;
  window.removeCartItem = removeFromCart;

  function renderCart() {
    if (cart.length === 0) {
      cartList.classList.add('hidden');
      cartEmpty.classList.remove('hidden');
      return;
    }

    cartList.classList.remove('hidden');
    cartEmpty.classList.add('hidden');

    cartList.innerHTML = cart.map(item => `
      <div class="flex items-center gap-3 bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
        <div class="w-12 h-12 bg-slate-100 rounded-lg overflow-hidden shrink-0">
          <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover">
        </div>
        <div class="flex-1 min-w-0">
          <h4 class="font-bold text-slate-800 text-sm truncate">${item.name}</h4>
          <p class="text-[10px] text-slate-500">Rp ${item.price.toLocaleString('id-ID')}/${item.unit}</p>
        </div>
        <div class="flex items-center gap-2 bg-slate-50 rounded-lg px-2 py-1">
          <button type="button" onclick="window.updateCartQuantity('${item.id}', -1)" class="w-5 h-5 flex items-center justify-center text-slate-500 hover:text-slate-800 bg-white rounded shadow-sm text-xs">-</button>
          <span class="text-sm font-bold text-slate-800 min-w-[1rem] text-center">${item.quantity}</span>
          <button type="button" onclick="window.updateCartQuantity('${item.id}', 1)" class="w-5 h-5 flex items-center justify-center text-slate-500 hover:text-slate-800 bg-white rounded shadow-sm text-xs">+</button>
        </div>
        <button type="button" onclick="window.removeCartItem('${item.id}')" class="text-slate-400 hover:text-red-500 p-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </button>
      </div>
    `).join('');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (cart.length === 0) {
      alert('Mohon pilih minimal satu jenis sampah.');
      return;
    }

    const formData = new FormData(form);
    
    // Save to LocalStorage if checked
    if (rememberCheckbox.checked) {
        const info = {
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone')
        };
        // Encode to base64
        localStorage.setItem(STORAGE_KEY, btoa(JSON.stringify(info)));
    } else {
        localStorage.removeItem(STORAGE_KEY);
    }

    const data = {
      personalInfo: {
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone')
      },
      pickupAddress: {
        regencyId: formData.get('regency'),
        fullAddress: formData.get('address')
      },
      notes: formData.get('notes'),
      cart: cart
    };

    console.log('Submission Data:', data);
    alert('Permintaan penjemputan berhasil dikirim!'); 
    // In a real app, you would POST this data to an API here.
  });

  // Image Upload Logic
  const dropzoneFile = document.getElementById('dropzone-file');
  const imagePreviewContainer = document.getElementById('image-preview-container');
  const imagePreview = document.getElementById('image-preview');
  const removeImageBtn = document.getElementById('remove-image');

  if (dropzoneFile) {
    dropzoneFile.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        const reader = new FileReader();
        reader.onload = (e) => {
          if (imagePreview) imagePreview.src = e.target.result;
          if (imagePreviewContainer) imagePreviewContainer.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
    });
  }

  if (removeImageBtn) {
    removeImageBtn.addEventListener('click', () => {
      if (dropzoneFile) dropzoneFile.value = '';
      if (imagePreview) imagePreview.src = '#';
      if (imagePreviewContainer) imagePreviewContainer.classList.add('hidden');
    });
  }
</script>
