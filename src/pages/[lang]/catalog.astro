---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { useTranslations } from "@/i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "id" } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const response = await fetch('https://api.kepul.id/v2/products?limit=100');
const result = await response.json();

const productsByCategory = result.data.products.reduce((acc, product) => {
  if (!acc[product.category]) {
    acc[product.category] = [];
  }
  acc[product.category].push(product);
  return acc;
}, {});
---

<Layout title={t("catalog.title")} lang={lang}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("catalog.title")}</Fragment>
      <Fragment slot="desc">{t("catalog.description")}</Fragment>
    </Sectionhead>
    <div class="mt-12">
      {Object.entries(productsByCategory).map(([category, products]) => (
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-800 mb-4">{category}</h2>
          <div class="flex overflow-x-auto space-x-4 pb-4">
            {products.map((product) => (
              <div
                class="flex-none w-48 flex flex-col border-2 border-[#D8DEE9] border-opacity-50 rounded-md overflow-hidden"
              >
                <div class="w-full aspect-square">
                  <Picture
                    src={product.image_url}
                    width={400}
                    height={400}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    alt={product.name}
                    class="w-full rounded-sm transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                  />
                </div>

                <div class="text-left py-3 px-3">
                  <h4 class="font-medium text-gray-400 truncate">{product.name}</h4>
                  <p class="mt-3 text-lg font-bold text-black flex items-center">
                    {
                      product.price_after > product.price_before ? (
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-green-500 mr-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
                        </svg>
                      ) : product.price_after < product.price_before ? (
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-red-500 mr-1">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
                        </svg>
                      ) : (
                        ''
                      )
                    }
                    Rp {product.price_after.toLocaleString('id-ID')}/{product.unit_type}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Layout>
