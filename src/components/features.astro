---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Jual Sampah",
    description:
      "Jual sampah daur ulang (non-B3), daftarkan sampah anda dan dapatkan uang tunai dan jaga lingkungan.",
    icon: "bx:bxs-trash",
  },
  {
    title: "Sedekah Sampah",
    description:
      "Donasikan sampah daur ulang untuk sosial, sumbangkan sampah anda untuk program amal yang terpercaya.",
    icon: "bx:bxs-donate-heart",
  },
  {
    title: "Kepul Point",
    description:
      "Antar dan jual sampah daur ulang secara mandiri di Kepul Point terdekat anda.",
    icon: "bx:bxs-map",
  },
  {
    title: "Bisnis & Event",
    description:
      "Kelola dan atur penjemputan sampah daur ulang dari perusahaan atau acara anda melalui Kepul.",
    icon: "bx:bxs-calendar-event",
  },
  {
    title: "Sekolah Bebas Sampah",
    description:
      "Memberdayakan siswa sekolah untuk mendapatkan uang kas atau tabungan tambahan dengan sampah daur ulang.",
    icon: "bx:bxs-school",
  },
  {
    title: "Sembako Sampah",
    description:
      "Membantu masyarakat mendapatkan berbagai kebutuhan dengan harga lebih murah dengan potongan harga jual sampah daur ulang.",
    icon: "bx:bxs-store",
  },
];
---

<div class="text-center">
  <span class="text-primary font-bold tracking-wider uppercase text-sm bg-sky-100 px-3 py-1 rounded-full">Keunggulan</span>
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-4 text-slate-800">
    Kenapa harus di <span class="text-primary">Kepul.id?</span>
  </h2>
  <p class="text-slate-500 mt-4 text-lg max-w-2xl mx-auto">Kami menyediakan berbagai layanan untuk memudahkan pengelolaan sampah daur ulang Anda.</p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-8">
  {
    features.map((item) => (
      <div class="flex flex-col gap-4 p-8 rounded-2xl bg-white border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-14 h-14 bg-sky-100 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:rotate-6 transition-all duration-300">
          <Icon class="text-primary w-7 h-7 group-hover:text-white transition-colors" name={item.icon} />
        </div>
        <div>
          <h3 class="font-bold text-xl text-slate-800 mb-2">{item.title}</h3>
          <p class="text-slate-500 leading-relaxed text-sm">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
