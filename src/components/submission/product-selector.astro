---
// Fetch products for the selector
const response = await fetch('https://api.kepul.id/v2/products?limit=100');
const result = await response.json();
const products = result.data.products;
---

<div id="product-selector-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 transition-opacity backdrop-blur-sm" id="product-selector-backdrop"></div>

  <!-- Modal Panel -->
  <div class="relative w-full max-w-3xl max-h-[85vh] bg-white rounded-2xl shadow-xl flex flex-col transition-all duration-300 transform scale-95 opacity-0" id="product-selector-panel">
    
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-slate-100 shrink-0">
      <h3 class="text-xl font-bold text-slate-800">Pilih Produk</h3>
      <button type="button" id="close-product-selector" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors">
        <span class="sr-only">Close</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto min-h-0 p-6 bg-slate-50 overscroll-contain">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {products.map((product) => (
          <button 
            type="button"
            class="product-item flex flex-col bg-white rounded-xl border border-slate-200 shadow-sm hover:border-primary hover:shadow-md transition-all p-3 text-left group h-full"
            data-id={product.id}
            data-name={product.name}
            data-price={product.price_after}
            data-unit={product.unit_type}
            data-image={product.image_url}
          >
            <div class="w-full aspect-square bg-slate-100 rounded-lg mb-3 overflow-hidden text-center relative">
               <img src={product.image_url} alt={product.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
            </div>
            <h4 class="font-bold text-slate-800 text-sm mb-1 line-clamp-2">{product.name}</h4>
            <p class="text-xs text-slate-500">
              Rp {product.price_after.toLocaleString('id-ID')}/{product.unit_type}
            </p>
          </button>
        ))}
      </div>
    </div>

    <!-- Footer -->
    <div class="p-4 border-t border-slate-100 bg-white rounded-b-2xl shrink-0">
        <p class="text-sm text-slate-500 text-center mb-0">Klik item untuk menambahkan ke keranjang</p>
    </div>
  </div>
</div>

<script>
  // Simple vanilla JS interactions for the modal
  const modal = document.getElementById('product-selector-modal');
  const panel = document.getElementById('product-selector-panel');
  const backdrop = document.getElementById('product-selector-backdrop');
  const closeBtn = document.getElementById('close-product-selector');
  const productButtons = document.querySelectorAll('.product-item');

  function openModal() {
    if (!modal || !panel) return;
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
    modal.classList.remove('hidden');
    // Small delay to allow display:block to apply before transition
    setTimeout(() => {
        panel.classList.remove('scale-95', 'opacity-0');
    }, 10);
  }

  function closeModal() {
    if (!modal || !panel) return;
    document.body.style.overflow = ''; // Restore background scrolling
    panel.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
        modal.classList.add('hidden');
    }, 300);
  }

  // Expose open function globally or via event
  window.openProductSelector = openModal;

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  productButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const data = {
        id: btn.getAttribute('data-id'),
        name: btn.getAttribute('data-name'),
        price: parseInt(btn.getAttribute('data-price') || '0'),
        unit: btn.getAttribute('data-unit'),
        image: btn.getAttribute('data-image')
      };
      
      // Dispatch custom event with product data
      const event = new CustomEvent('product-selected', { detail: data });
      window.dispatchEvent(event);
      
      closeModal();
    });
  });
</script>
