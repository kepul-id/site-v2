---
// @ts-ignore
import StepCard from "@/components/step.astro";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  {
    name: t("howto.step_one_name"),
    step: t("howto.step_one_step"),
    desc: t("howto.step_one_desc"),
    img: "/steps/kepul-il-1.png",
  },
  {
    name: t("howto.step_two_name"),
    step: t("howto.step_two_step"),
    desc: t("howto.step_two_desc"),
    img: "/steps/kepul-il-2.png",
  },
  {
    name: t("howto.step_three_name"),
    step: t("howto.step_three_step"),
    desc: t("howto.step_three_desc"),
    img: "/steps/kepul-il-3.png",
  },
  {
    name: t("howto.step_four_name"),
    step: t("howto.step_four_step"),
    desc: t("howto.step_four_desc"),
    img: "/steps/kepul-il-4.png",
  },
];
---

<div class="mt-16 md:mt-0 pt-12">
    <h2 class="text-4xl lg:text-4xl font-bold lg:tracking-tight">{t("howto.title")}</h2>
    <p class="text-slate-500 mt-2 leading-relaxed">{t("howto.description")}</p>
</div>
  
<div
    class="grid grid-cols-2 md:grid-cols-4 gap-6 mx-auto mt-12">
    {steps.map((item) => <StepCard step={item} lang={lang} />)}
</div>