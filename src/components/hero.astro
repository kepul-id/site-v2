---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
import kepulIntro from "@/assets/intro.mp4";
---

<main class="relative w-full min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Video Background -->
  <div class="absolute inset-0 w-full h-full">
    <video
      class="object-cover w-full h-full transform scale-105"
      autoplay
      loop
      muted
      playsinline>
      <source src={kepulIntro} type="video/mp4" />
    </video>
    <!-- Modern Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-sky-900/90 via-black/50 to-black/30"></div>
    <!-- Mesh Texture Overlay for texture -->
    <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-20"></div>
  </div>

  <!-- Content -->
  <div class="relative z-20 w-full px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-8 animate-fade-in-up">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
        </span>
        <span class="text-sky-100 text-sm font-medium tracking-wide">Solusi Sampah Digital #1 di Indonesia</span>
      </div>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-white to-white/70 drop-shadow-sm mb-6 leading-tight">
        Jual Sampah <br class="hidden md:block"/> <span class="bg-gradient-to-r from-sky-400 to-blue-300 bg-clip-text text-transparent">Jadi Berkah</span>
      </h1>
      
      <p class="text-lg md:text-2xl text-slate-200 max-w-2xl mx-auto leading-relaxed mb-10 font-light">
        Kami hadir untuk <b class="text-white font-semibold">mendaur ulang</b> limbah domestik (Non B3) demi mewujudkan Indonesia yang lebih bersih dan hijau.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Link
          href="https://play.google.com/store/apps/details?id=app.kepul.id&hl=id"
          target="_blank"
          class="flex gap-2 items-center justify-center px-8 py-4 bg-primary hover:bg-sky-600 text-white rounded-full font-semibold transition-all hover:scale-105 hover:shadow-lg hover:shadow-sky-500/30 text-lg group"
          rel="noopener">
          <Icon class="text-white w-6 h-6 group-hover:-translate-y-1 transition-transform" name="bx:bxs-cloud-download" />
          Download App
        </Link>
        <Link
          href="#"
          class="flex gap-2 items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/20 rounded-full font-semibold transition-all backdrop-blur-sm text-lg"
          rel="noopener">
          Pelajari Lebih Lanjut
        </Link>
      </div>
    </div>
  </div>
</main>
