---
const stats = [
  {
    count: "10K+",
    label: "Ton Sampah Terkumpul",
    desc: "Limbah yang berhasil didaur ulang",
  },
  {
    count: "50K+",
    label: "Pengguna Aktif",
    desc: "Masyarakat yang peduli lingkungan",
  },
  {
    count: "50+",
    label: "Mitra Bisnis",
    desc: "Perusahaan yang bergabung dengan kami",
  },
  {
    count: "25%",
    label: "Reduksi Emisi",
    desc: "Kontribusi terhadap pengurangan jejak karbon",
  },
];
---

<div class="mt-24 px-4">
  <div class="max-w-7xl mx-auto bg-primary rounded-3xl p-8 md:p-16 text-center text-white relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10 bg-[url('/grid.svg')]"></div>
    <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full mix-blend-overlay filter blur-3xl opacity-20 translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-sky-300 rounded-full mix-blend-overlay filter blur-3xl opacity-20 -translate-x-1/3 translate-y-1/3"></div>

    <div class="relative z-10 grid grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12">
      {stats.map((stat) => (
        <div class="flex flex-col items-center group">
          <span class="text-4xl md:text-5xl lg:text-6xl font-black mb-2 tracking-tight group-hover:scale-110 transition-transform duration-300">{stat.count}</span>
          <span class="text-lg md:text-xl font-bold mb-1 opacity-90">{stat.label}</span>
          <span class="text-sm opacity-70 max-w-[150px]">{stat.desc}</span>
        </div>
      ))}
    </div>
  </div>
</div>
