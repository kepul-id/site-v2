---
const icons = [
  {
    "url": "https://static.wikia.nocookie.net/logopedia/images/4/42/Narasi_%282018%29.svg",
    "alt": "Narasi"
  },
  {
    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/a/ad/IDN_Media.svg/800px-IDN_Media.svg.png",
    "alt": "IDN"
  },
  {
    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Kompas.svg/800px-Kompas.svg.png",
    "alt": "Kompas"
  },
  {
    "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/Jawa_Pos.png/800px-Jawa_Pos.png",
    "alt": "Jawa Pos"
  }
];
---

<div class="mt-24 border-t border-slate-100 pt-16">
  <h2 class="text-center text-slate-400 font-medium tracking-wide uppercase text-sm mb-10">Telah diliput oleh Media Ternama</h2>
  <div class="flex gap-10 md:gap-20 items-center justify-center flex-wrap">
    {icons.map((icon) => (
      <div class="group relative">
        <img 
          src={icon.url} 
          alt={icon.alt}
          class="h-6 md:h-8 w-auto object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 transform group-hover:scale-105"
        />
      </div>
    ))}
  </div>
</div>
